# Gemini API key for server-side AI chat and symptom-triage requests.
# Replace the placeholder in your private local .env file; never commit the real key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional model ID. Defaults to gemini-3.5-flash-lite when omitted.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional server port (defaults to 3000).
# PORT="3000"
